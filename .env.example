PORT=3777
MONGODB_URI=mongodb://localhost:27017/projectshub
JWT_SECRET=your_jwt_secret_here
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3777/api/auth/github/callback
FRONTEND_URL=http://localhost:4567
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twenty CRM (self-hosted, see docker-compose.yml)
# Generate with: openssl rand -hex 32
TWENTY_APP_SECRET=
TWENTY_BASE_URL=http://localhost:3000
# Shared admin API key — create one workspace manually via UI, then
# generate the key at /settings/api-webhooks. All ProjectsHub projects share this.
TWENTY_ADMIN_API_KEY=
# Subdomain of the workspace (used for iframe deep-link URLs)
TWENTY_WORKSPACE_SUBDOMAIN=projectshub
